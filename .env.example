NODE_ENV=development
PORT=4000
LOG_LEVEL=info

POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/express_api

# Browser origins allowed to call the API (the Next.js site). Also used for CSRF checks.
CORS_ORIGINS=http://localhost:3000
# Number of proxies in front of the API (load balancer, nginx...). 0 when exposed directly.
TRUST_PROXY=0
# openssl rand -hex 32
IP_HASH_SECRET=replace_me_with_a_long_random_string

SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=pt_session

# SeaweedFS S3 gateway in dev (docker compose); leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=philtech-resumes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_FORCE_PATH_STYLE=true

# Mailpit in dev (docker compose).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PhilTech Solutions <no-reply@philtechsol.com>"
NOTIFY_EMAIL_TO=info@philtechsol.com

COMPANY_TIMEZONE=Asia/Tbilisi
BOOKING_TIMEZONE=Asia/Tbilisi
BOOKING_WEEKDAYS=1,2,3,4,5
BOOKING_SLOTS=17:30,18:30,19:30,20:30,21:30
BOOKING_SLOT_MINUTES=60
BOOKING_MIN_LEAD_HOURS=12
BOOKING_MAX_DAYS_AHEAD=60

PRIVACY_POLICY_VERSION=2026-01
RETENTION_MONTHS=24

# Optional Cloudflare Turnstile secret; when set, public forms must send turnstileToken.
TURNSTILE_SECRET=
AUDIT_RETENTION_DAYS=730
AUDIT_IDLE_JOB_RUNS=false
